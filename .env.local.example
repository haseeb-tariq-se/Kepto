# ============================================================
#  Kepto — environment variables. Copy to .env.local and fill in.
#  Everything here is a FREE tier. See README for cost notes.
# ============================================================

# --- Supabase (free tier) — Project Settings -> API ---
# Public values (safe in the browser). NEXT_PUBLIC_ ones power login/signup.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret. NEVER expose this in the browser. Used by /api routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Groq (free tier) — text, vision, and Whisper transcription ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# --- Cohere (free trial key) — embeddings for semantic search ---
# Get a key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key

# --- OPTIONAL: social-video extractor worker (yt-dlp + Whisper + vision) ---
# Leave blank to keep social links in "stub" mode (router still detects them,
# standard links work fully). Point this at your deployed Python worker
# (see /worker) to turn on real Instagram/TikTok/YouTube/X analysis.
SOCIAL_WORKER_URL=
